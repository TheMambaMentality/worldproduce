<section class="section">
  <div class="section__inner">
    <header class="section__head">
      <h1 class="section__title">Store</h1>
      <p class="section__lead">店舗一覧</p>
    </header>

    <section class="store-grid">
      <% (@stores || []).each do |store| %>
        <article class="store-card">
          <div class="store-card__photo">
            <%= image_tag "stores/#{store[:image]}", alt: store[:name] %>
          </div>

          <div class="store-card__body">
            <h2 class="store-card__name"><%= store[:name] %></h2>
            <p class="store-card__facility"><%= store[:facility] %></p>

            <dl class="store-card__meta">
              <div>
                <dt>住所</dt>
                <dd>
                  <a href="<%= store[:map_url] %>" target="_blank" rel="noopener">
                    <%= store[:address] %>
                  </a>
                </dd>
              </div>
              <div>
                <dt>電話</dt>
                <dd><a href="tel:<%= store[:tel] %>"><%= store[:tel] %></a></dd>
              </div>
            </dl>

            <p class="store-card__map">
            <a href="<%= store[:map_url] %>" target="_blank" rel="noopener">
              Google Mapで見る
            </a>
          
            <% if store[:instagram_url].present? %>
              <a href="<%= store[:instagram_url] %>"
                target="_blank"
                rel="noopener"
                class="store-card__ig"
                aria-label="Instagram"
              >
                <!-- Instagram SVG（黒） -->
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7.75 2h8.5A5.75 5.75 0 0 1 22 7.75v8.5A5.75 5.75 0 0 1 16.25 22h-8.5A5.75 5.75 0 0 1 2 16.25v-8.5A5.75 5.75 0 0 1 7.75 2zm0 1.5A4.25 4.25 0 0 0 3.5 7.75v8.5A4.25 4.25 0 0 0 7.75 20.5h8.5a4.25 4.25 0 0 0 4.25-4.25v-8.5A4.25 4.25 0 0 0 16.25 3.5h-8.5zM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10zm0 1.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zm5.25-.88a1.13 1.13 0 1 1 0 2.25 1.13 1.13 0 0 1 0-2.25z"/>
                </svg>
              </a>
            <% end %>
            </p>
          </div>
        </article>
      <% end %>
    </section>
  </div>
</section>